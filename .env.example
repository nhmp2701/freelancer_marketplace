# PostgreSQL used by Backend/docker-compose.yml and the Spring application.
POSTGRES_DB=freelance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Optional locally (the backend generates an ephemeral key when omitted).
# Required with SPRING_PROFILES_ACTIVE=prod; use at least 32 random bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=86400000
SPRING_PROFILES_ACTIVE=dev

# Comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
